+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { URI } from '../../../../base/common/uri.js';
+
+/**
+ * StorageLayout manages centralized external paths for Multi-Agent IDE.
+ * All plans, tasks, and staging diffs live in ~/.multi-agent-ide/brain/<slug>/
+ * to guarantee ZERO root clutter in the user's project workspace.
+ */
+export class StorageLayout {
+	public static getProjectSlug(folderUri: URI): string {
+		const str = folderUri.fsPath;
+		let hash = 5381;
+		for (let i = 0; i < str.length; i++) {
+			hash = ((hash << 5) + hash) + str.charCodeAt(i);
+			hash = hash & hash;
+		}
+		const hex = Math.abs(hash).toString(16).padStart(8, '0');
+		const segments = folderUri.path.split('/').filter(Boolean);
+		const base = segments[segments.length - 1] || 'workspace';
+		const cleanBase = base.replace(/[^a-zA-Z0-9_-]/g, '_');
+		return `${cleanBase}-${hex}`;
+	}
+
+	public static getGlobalRoot(userHomeUri?: URI): URI {
+		if (userHomeUri) {
+			return URI.joinPath(userHomeUri, '.multi-agent-ide');
+		}
+		// Fallback to standard home
+		return URI.file('/tmp/.multi-agent-ide');
+	}
+
+	public static getBrainDir(userHomeUri: URI, workspaceUri: URI): URI {
+		const slug = StorageLayout.getProjectSlug(workspaceUri);
+		return URI.joinPath(StorageLayout.getGlobalRoot(userHomeUri), 'brain', slug);
+	}
+
+	public static getPlanFile(userHomeUri: URI, workspaceUri: URI): URI {
+		return URI.joinPath(StorageLayout.getBrainDir(userHomeUri, workspaceUri), 'PLAN.md');
+	}
+
+	public static getTaskFile(userHomeUri: URI, workspaceUri: URI): URI {
+		return URI.joinPath(StorageLayout.getBrainDir(userHomeUri, workspaceUri), 'task.json');
+	}
+
+	public static getDiffStagingFile(userHomeUri: URI, workspaceUri: URI): URI {
+		return URI.joinPath(StorageLayout.getBrainDir(userHomeUri, workspaceUri), 'DIFF_STAGING.diff');
