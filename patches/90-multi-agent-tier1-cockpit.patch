+
+export class MultiAgentChatControlView extends ViewPane {
+	public static readonly ID = 'multiAgent.chatControlView';
+	public static readonly TITLE = 'MA Chat & Control View';
+
+	private _rootContainer!: HTMLElement;
+	private _hudElement!: HTMLElement;
+	private _streamElement!: HTMLElement;
+	private _approvalBarElement!: HTMLElement;
+	private _stagingBarElement!: HTMLElement;
+	private _stagingCountLabel!: HTMLElement;
+	private _inputElement!: HTMLTextAreaElement;
+	private _sendButton!: HTMLButtonElement;
+	private _sendIconSpan!: HTMLElement;
+
+	private _thinkingAccordion?: HTMLElement;
+	private _thinkingAccordionBody?: HTMLElement;
+	private _thinkingTitleLabel?: HTMLElement;
