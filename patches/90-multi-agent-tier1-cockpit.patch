+
+import { IConfigurationRegistry, Extensions as ConfigurationExtensions, ConfigurationScope } from '../../../../platform/configuration/common/configurationRegistry.js';
+import { IQuickInputService, IQuickPickItem } from '../../../../platform/quickinput/common/quickInput.js';
+
+// 1. Register Native IMultiAgentService Singleton
+registerSingleton(IMultiAgentService, MultiAgentService, InstantiationType.Delayed);
+
+// Configuration Registration
+const configurationRegistry = Registry.as<IConfigurationRegistry>(ConfigurationExtensions.Configuration);
+configurationRegistry.registerConfiguration({
+	id: 'chat',
+	order: 15,
+	title: localize('chat.agent.configurationTitle', "Chat > Agent"),
+	type: 'object',
+	properties: {
+		'chat.agent.architect': {
+			type: 'string',
+			scope: ConfigurationScope.APPLICATION,
+			enum: ['antigravity', 'claude', 'codex', 'copilot'],
+			enumDescriptions: [
+				localize('chat.agent.architect.antigravity', "Google Antigravity CLI (agy)"),
+				localize('chat.agent.architect.claude', "Anthropic Claude CLI (claude)"),
+				localize('chat.agent.architect.codex', "OpenAI Codex CLI (codex)"),
+				localize('chat.agent.architect.copilot', "GitHub Copilot CLI (copilot)")
+			],
+			default: 'antigravity',
+			markdownDescription: localize('chat.agent.architect.description', "Lead Architect agent for codebase reasoning, solution design, and plan generation. [Authenticate CLI Accounts](command:workbench.action.multiAgent.loginAccount) | [Run Doctor Health Check](command:workbench.action.multiAgent.doctor)")
+		},
+		'chat.agent.worker': {
+			type: 'string',
+			scope: ConfigurationScope.APPLICATION,
+			enum: ['copilot', 'antigravity', 'claude', 'codex'],
+			enumDescriptions: [
+				localize('chat.agent.worker.copilot', "GitHub Copilot CLI (copilot)"),
+				localize('chat.agent.worker.antigravity', "Google Antigravity CLI (agy)"),
+				localize('chat.agent.worker.claude', "Anthropic Claude CLI (claude)"),
+				localize('chat.agent.worker.codex', "OpenAI Codex CLI (codex)")
+			],
+			default: 'copilot',
+			markdownDescription: localize('chat.agent.worker.description', "Worker agent for isolated worktree code authoring and execution. [Authenticate CLI Accounts](command:workbench.action.multiAgent.loginAccount)")
+		},
+		'chat.agent.auditor': {
+			type: 'string',
+			scope: ConfigurationScope.APPLICATION,
+			enum: ['antigravity', 'claude', 'codex', 'copilot'],
+			enumDescriptions: [
+				localize('chat.agent.auditor.antigravity', "Google Antigravity CLI (agy)"),
+				localize('chat.agent.auditor.claude', "Anthropic Claude CLI (claude)"),
+				localize('chat.agent.auditor.codex', "OpenAI Codex CLI (codex)"),
+				localize('chat.agent.auditor.copilot', "GitHub Copilot CLI (copilot)")
+			],
+			default: 'antigravity',
+			markdownDescription: localize('chat.agent.auditor.description', "Auditor agent for diagnostics, code verification, and task completion verdicts. [Authenticate CLI Accounts](command:workbench.action.multiAgent.loginAccount)")
+		},
+		'chat.agent.autopilot': {
+			type: 'boolean',
+			scope: ConfigurationScope.APPLICATION,
+			default: false,
+			markdownDescription: localize('chat.agent.autopilot.description', "When enabled, automatically approves generated plans and triggers worker execution without waiting for manual human confirmation.")
+		},
+		'multiAgent.roleMapping': {
+			type: 'object',
+			scope: ConfigurationScope.APPLICATION,
+			description: localize('multiAgent.roleMapping.description', "Mapping of Swarm roles to AI Agent engines (e.g. antigravity, copilot, codex, claude)."),
+			default: {
+				architect: 'antigravity',
+				worker: 'copilot',
+				auditor: 'antigravity'
+			}
+		},
+		'multiAgent.customProviders': {
+			type: 'array',
+			scope: ConfigurationScope.APPLICATION,
+			description: localize('multiAgent.customProviders.description', "Custom Agent CLI providers registered in the IDE."),
+			default: []
+		}
+	}
+});
+
+// 2. Register Continuous Multi-Diff Contributions (Tier 2)
+registerAction2(OpenAgentMultiDiffEditorAction);
+registerAction2(UpdateAgentMultiDiffEntriesAction);
+registerWorkbenchContribution2(
+	AgentMultiDiffContribution.ID,
+	AgentMultiDiffContribution,
+	WorkbenchPhase.BlockStartup
+);
+
+// 3. Register MA Chat & Control ViewContainer in Secondary Sidebar (Auxiliary Bar)
+export const MULTI_AGENT_VIEW_CONTAINER_ID = 'workbench.view.multiAgent';
+
+const multiAgentViewContainer: ViewContainer = Registry.as<IViewContainersRegistry>(ViewContainerExtensions.ViewContainersRegistry).registerViewContainer({
+	id: MULTI_AGENT_VIEW_CONTAINER_ID,
+	title: localize2('multiAgent.containerTitle', "MA Chat & Control"),
+	icon: Codicon.sparkle,
+	ctorDescriptor: new SyncDescriptor(ViewPaneContainer, [MULTI_AGENT_VIEW_CONTAINER_ID, { mergeViewWithContainerWhenSingleView: true }]),
+	storageId: MULTI_AGENT_VIEW_CONTAINER_ID,
+	hideIfEmpty: false,
+	order: 1,
+}, ViewContainerLocation.AuxiliaryBar, { isDefault: true });
+
+// 4. Register MA Chat & Control View inside Container
+const viewsRegistry = Registry.as<IViewsRegistry>(ViewContainerExtensions.ViewsRegistry);
+viewsRegistry.registerViews([{
+	id: MultiAgentChatControlView.ID,
+	name: localize2('multiAgent.chatControlView.title', "MA Chat & Control View"),
+	ctorDescriptor: new SyncDescriptor(MultiAgentChatControlView),
+	canToggleVisibility: false,
+	canMoveView: true,
+	order: 1,
+}], multiAgentViewContainer);
+
+// 5. Register Toggle/Focus Action for MA Chat & Control View
+export class ToggleMAChatControlAction extends Action2 {
+	static readonly ID = 'workbench.action.multiAgent.toggleChatControl';
+
+	constructor() {
+		super({
+			id: ToggleMAChatControlAction.ID,
+			title: localize2('multiAgent.toggleChatControl', "Toggle MA Chat & Control View"),
+			keybinding: {
+				primary: KeyMod.CtrlCmd | KeyMod.Alt | KeyCode.KeyM,
+				weight: 200
+			},
+			f1: true
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<void> {
+		const paneCompositePartService = accessor.get(IPaneCompositePartService);
+		await paneCompositePartService.openPaneComposite(MULTI_AGENT_VIEW_CONTAINER_ID, ViewContainerLocation.AuxiliaryBar, true);
+	}
+}
+
+registerAction2(ToggleMAChatControlAction);
+
+export class MultiAgentLoginAccountAction extends Action2 {
+	static readonly ID = 'workbench.action.multiAgent.loginAccount';
+
+	constructor() {
+		super({
+			id: MultiAgentLoginAccountAction.ID,
+			title: localize2('multiAgent.loginAccount', "Multi-Agent: Authenticate CLI Account"),
+			f1: true
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<void> {
+		const quickInputService = accessor.get(IQuickInputService);
+		const multiAgentService = accessor.get(IMultiAgentService);
+
+		const items: IQuickPickItem[] = [
+			{ id: 'antigravity', label: '$(sparkle) Google Antigravity (agy)', description: 'Native Google OAuth credentials' },
+			{ id: 'copilot', label: '$(github) GitHub Copilot CLI', description: 'gh auth login / copilot login' },
+			{ id: 'codex', label: '$(hubot) OpenAI Codex CLI', description: 'codex login' },
+			{ id: 'claude', label: '$(comment) Anthropic Claude CLI', description: 'claude login' },
+		];
+
+		const selected = await quickInputService.pick(items, {
+			placeHolder: 'Select CLI Agent account to authenticate'
+		});
+		if (selected && selected.id) {
+			await multiAgentService.loginProvider(selected.id);
+		}
+	}
+}
+registerAction2(MultiAgentLoginAccountAction);
+
+export class MultiAgentDoctorAction extends Action2 {
+	static readonly ID = 'workbench.action.multiAgent.doctor';
+
+	constructor() {
+		super({
+			id: MultiAgentDoctorAction.ID,
+			title: localize2('multiAgent.doctor', "Multi-Agent: Run Doctor Health Check"),
+			f1: true
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<void> {
+		const multiAgentService = accessor.get(IMultiAgentService);
+		await multiAgentService.runDoctor();
+	}
+}
+registerAction2(MultiAgentDoctorAction);
+
+export class MultiAgentNewSessionAction extends Action2 {
+	static readonly ID = 'workbench.action.multiAgent.newSession';
+
+	constructor() {
+		super({
+			id: MultiAgentNewSessionAction.ID,
+			title: localize2('multiAgent.newSession', "Multi-Agent: New Chat Session"),
+			f1: true
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<void> {
+		const multiAgentService = accessor.get(IMultiAgentService);
+		multiAgentService.clearSession();
+	}
+}
+registerAction2(MultiAgentNewSessionAction);
