+	private _renderInlineFormatted(container: HTMLElement, text: string): void {
+		const regex = /(\*\*[^*]+\*\*|`[^`]+`)/g;
+		let lastIndex = 0;
+		let match: RegExpExecArray | null;
+
+		while ((match = regex.exec(text)) !== null) {
+			if (match.index > lastIndex) {
+				container.appendChild(document.createTextNode(text.substring(lastIndex, match.index)));
+			}
+			const token = match[0];
+			if (token.startsWith('**') && token.endsWith('**')) {
+				const strong = document.createElement('strong');
+				strong.textContent = token.slice(2, -2);
+				container.appendChild(strong);
+			} else if (token.startsWith('`') && token.endsWith('`')) {
+				const code = document.createElement('code');
+				code.textContent = token.slice(1, -1);
+				code.style.padding = '1px 4px';
+				code.style.borderRadius = '3px';
+				code.style.backgroundColor = 'rgba(128, 128, 128, 0.2)';
+				code.style.fontFamily = 'monospace';
+				code.style.fontSize = '90%';
+				container.appendChild(code);
+			}
+			lastIndex = regex.lastIndex;
+		}
+
+		if (lastIndex < text.length) {
+			container.appendChild(document.createTextNode(text.substring(lastIndex)));
+		}
+	}
+
+	private _renderFormattedText(container: HTMLElement, text: string): void {
+		const lines = text.split('\n');
+		for (let i = 0; i < lines.length; i++) {
+			if (i > 0) {
+				container.appendChild(document.createElement('br'));
+			}
+			this._renderInlineFormatted(container, lines[i]);
+		}
+	}
+
+	private _appendMessageBubble(msg: ChatMessage): void {
+		const bubble = append(this._streamElement, $('.ma-message-bubble'));
+		bubble.style.padding = '8px 12px';
+		bubble.style.lineHeight = '1.5';
+		bubble.style.fontSize = '13px';
+
+		if (msg.sender === 'user') {
+			bubble.style.alignSelf = 'flex-end';
+			bubble.style.backgroundColor = '#1e2638';
+			bubble.style.color = '#f1f5f9';
+			bubble.style.borderRadius = '14px 14px 2px 14px';
+			bubble.style.maxWidth = '88%';
+			bubble.style.boxShadow = '0 2px 8px rgba(0, 0, 0, 0.15)';
+		} else if (msg.sender === 'system') {
+			bubble.style.alignSelf = 'center';
+			bubble.style.backgroundColor = 'rgba(128, 128, 128, 0.12)';
+			bubble.style.borderRadius = '12px';
+			bubble.style.fontSize = '11px';
+			bubble.style.opacity = '0.85';
+			bubble.style.padding = '3px 10px';
+		} else {
+			bubble.style.alignSelf = 'flex-start';
+			bubble.style.backgroundColor = 'rgba(255, 255, 255, 0.035)';
+			bubble.style.border = '1px solid rgba(255, 255, 255, 0.07)';
+			bubble.style.borderRadius = '14px 14px 14px 2px';
+			bubble.style.maxWidth = '94%';
+
+			const roleColor = msg.role === 'architect' ? '#3b82f6' : (msg.role === 'worker' ? '#a855f7' : '#10b981');
+			bubble.style.borderLeft = `3px solid ${roleColor}`;
+		}
+
+		if (msg.agentName) {
+			const header = append(bubble, $('.ma-msg-sender'));
+			header.style.fontWeight = 'bold';
+			header.style.fontSize = '11px';
+			header.style.marginBottom = '4px';
+			const roleColor = msg.role === 'architect' ? '#60a5fa' : (msg.role === 'worker' ? '#c084fc' : '#34d399');
+			header.style.color = roleColor;
+			header.textContent = `[${msg.role?.toUpperCase() || 'AGENT'}] ${msg.agentName}:`;
+		}
+
+		const body = append(bubble, $('.ma-msg-text'));
+		this._renderFormattedText(body, msg.text);
+	}
+
+	private _ensureThinkingAccordion(): HTMLElement {
+		if (this._thinkingAccordion && this._thinkingAccordion.isConnected) {
+			return this._thinkingAccordionBody!;
+		}
+
+		this._thinkingStartTime = Date.now();
+		this._thinkingAccordion = append(this._streamElement, $('.ma-thinking-accordion'));
+		this._thinkingAccordion.style.margin = '4px 0';
+		this._thinkingAccordion.style.borderRadius = '8px';
+		this._thinkingAccordion.style.border = '1px solid rgba(255, 255, 255, 0.08)';
+		this._thinkingAccordion.style.backgroundColor = 'rgba(255, 255, 255, 0.02)';
+		this._thinkingAccordion.style.overflow = 'hidden';
+
+		const header = append(this._thinkingAccordion, $('.ma-thinking-header'));
+		header.style.display = 'flex';
+		header.style.justifyContent = 'space-between';
+		header.style.alignItems = 'center';
+		header.style.padding = '6px 10px';
+		header.style.cursor = 'pointer';
+		header.style.fontSize = '11px';
+		header.style.fontWeight = '500';
+		header.style.color = 'var(--vscode-descriptionForeground, #94a3b8)';
+		header.style.userSelect = 'none';
+
+		this._thinkingTitleLabel = append(header, $('span'));
+		this._thinkingTitleLabel.textContent = '✦ Thinking (1s)';
+
+		const chevron = append(header, $('span'));
+		chevron.textContent = '▾';
+		chevron.style.fontSize = '10px';
+		chevron.style.opacity = '0.7';
+
+		this._thinkingAccordionBody = append(this._thinkingAccordion, $('.ma-thinking-body'));
+		this._thinkingAccordionBody.style.display = 'flex';
+		this._thinkingAccordionBody.style.flexDirection = 'column';
+		this._thinkingAccordionBody.style.gap = '4px';
+		this._thinkingAccordionBody.style.padding = '4px 10px 8px 16px';
+		this._thinkingAccordionBody.style.borderLeft = '2px solid rgba(148, 163, 184, 0.3)';
+		this._thinkingAccordionBody.style.marginLeft = '10px';
+
+		let isExpanded = true;
+		header.onclick = () => {
+			isExpanded = !isExpanded;
+			this._thinkingAccordionBody!.style.display = isExpanded ? 'flex' : 'none';
+			chevron.textContent = isExpanded ? '▾' : '▸';
+		};
+
+		return this._thinkingAccordionBody;
+	}
+
+	private _addThinkingStep(step: ThinkingStep): void {
+		if (!this._streamElement) return;
+
+		const body = this._ensureThinkingAccordion();
+		const elapsedSec = Math.max(1, Math.round((Date.now() - this._thinkingStartTime) / 1000));
+		if (this._thinkingTitleLabel) {
+			this._thinkingTitleLabel.textContent = `✦ Thinking (${elapsedSec}s)`;
+		}
+
+		const stepEl = append(body, $('.ma-thinking-item'));
+		stepEl.style.fontSize = '11px';
+		stepEl.style.color = 'var(--vscode-descriptionForeground, #94a3b8)';
+		stepEl.style.lineHeight = '1.4';
+		stepEl.textContent = `⚡ [${step.role.toUpperCase()}] ${step.agent}: ${step.text}`;
+
+		this._streamElement.scrollTop = this._streamElement.scrollHeight;
+	}
+}
