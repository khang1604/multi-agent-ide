+		this._thinkingTitleLabel = undefined;
+
+		const messages = this.multiAgentService.getMessages();
+		for (const msg of messages) {
+			if (!msg.text && msg.sender === 'system') continue;
+			this._appendMessageBubble(msg);
+		}
