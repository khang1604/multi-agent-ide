+ *--------------------------------------------------------------------------------------------*/
+
+import { createDecorator } from '../../../../platform/instantiation/common/instantiation.js';
+import { Event } from '../../../../base/common/event.js';
+
+export const IMultiAgentService = createDecorator<IMultiAgentService>('multiAgentService');
+
+export type SwarmState = 'idle' | 'planning' | 'waiting_approval' | 'executing' | 'auditing' | 'completed' | 'error';
+
+export interface SwarmStats {
+	readonly tokenCount: number;
+	readonly tokensPerSec: number;
+	readonly estimatedCostUsd: number;
+}
+
+export interface SwarmRoleMapping {
+	readonly architect: string;
+	readonly worker: string;
+	readonly auditor: string;
+}
+
+export interface SwarmStatus {
+	readonly state: SwarmState;
+	readonly currentTaskId?: string;
+	readonly currentObjective?: string;
+	readonly activeRole?: string;
+	readonly activeAgent?: string;
+	readonly roles: SwarmRoleMapping;
+	readonly stats: SwarmStats;
+	readonly autopilot: boolean;
+	readonly error?: string;
+}
+
+export interface ThinkingStep {
+	readonly id: string;
+	readonly agent: string;
+	readonly role: string;
+	readonly text: string;
+	readonly timestamp: number;
+}
+
+export interface ChatMessage {
+	readonly id: string;
+	readonly sender: 'user' | 'agent' | 'system';
+	readonly agentName?: string;
+	readonly role?: string;
+	readonly text: string;
+	readonly timestamp: number;
+	readonly isPlan?: boolean;
+}
+
+export interface PlanUpdateEvent {
+	readonly taskId: string;
+	readonly planContent: string;
+	readonly planPath?: string;
+	readonly complexity?: string;
+	readonly strategy?: string;
+	readonly tasks?: Array<{ id: string; title: string; worker: string; status: string }>;
+	readonly acceptanceCriteria?: string[];
+}
+
+export interface StagingUpdateEvent {
+	readonly taskId: string;
+	readonly worktreePath?: string;
+	readonly changedFiles: string[];
+	readonly diffPath?: string;
+}
+
+export interface IMultiAgentService {
+	readonly _serviceBrand: undefined;
+
+	readonly onDidChangeStatus: Event<SwarmStatus>;
+	readonly onDidPlanUpdate: Event<PlanUpdateEvent>;
+	readonly onDidStagingUpdate: Event<StagingUpdateEvent>;
+	readonly onDidThinkingStep: Event<ThinkingStep>;
+	readonly onDidMessage: Event<ChatMessage>;
+
+	getStatus(): SwarmStatus;
+	getMessages(): readonly ChatMessage[];
+	getThinkingSteps(): readonly ThinkingStep[];
+	getStaging(): StagingUpdateEvent | undefined;
+
+	dispatch(objective: string): Promise<string>;
+	approvePlan(taskId?: string): Promise<void>;
+	rejectPlan(taskId?: string, feedback?: string): Promise<void>;
+	cancelTask(taskId?: string): Promise<void>;
+	acceptStaging(taskId?: string): Promise<void>;
+	rejectStaging(taskId?: string): Promise<void>;
+
+	loginProvider(provider: string): Promise<void>;
+	runDoctor(): Promise<void>;
+	clearSession(): void;
+
+	setAutopilot(enabled: boolean): void;
+	isAutopilotEnabled(): boolean;
+}
+
