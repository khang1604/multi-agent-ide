{
  "schema_version": 1,
  "security": {
    "require_isolation": false,
    "isolated_test_environment": false,
    "synthetic_data_only": true,
    "isolation_description": ""
  },
  "leader_priority": [
    "antigravity",
    "claude",
    "codex",
    "copilot"
  ],
  "worker_priority": [
    "codex",
    "claude",
    "antigravity"
  ],
  "reviewer_priority": [
    "antigravity",
    "claude",
    "copilot",
    "codex"
  ],
  "providers": {
    "antigravity": {
      "command": [
        "agy"
      ],
      "enabled": true,
      "roles": [
        "plan",
        "implement",
        "review"
      ]
    },
    "codex": {
      "command": [
        "codex"
      ],
      "enabled": true,
      "roles": [
        "plan",
        "implement",
        "review"
      ]
    },
    "claude": {
      "command": [
        "claude"
      ],
      "enabled": true,
      "roles": [
        "plan",
        "implement",
        "review"
      ]
    },
    "copilot": {
      "command": [
        "copilot"
      ],
      "enabled": true,
      "roles": [
        "plan",
        "review"
      ]
    }
  },
  "auto": {
    "small": {
      "max_calls": 2,
      "max_repairs": 0,
      "reviewers": 0
    },
    "standard": {
      "max_calls": 6,
      "max_repairs": 3,
      "reviewers": 1
    },
    "complex": {
      "max_calls": 9,
      "max_repairs": 3,
      "reviewers": 2
    }
  },
  "permissions": {
    "mcp_config_write": false
  },
  "max_context_chars": 40000,
  "agent_timeout_seconds": 600,
  "verify_timeout_seconds": 120,
  "quota_cooldown_seconds": 1800,
  "temporary_cooldown_seconds": 120,
  "max_workflow_age_hours": 24,
  "poll_seconds": 2,
  "max_log_bytes": 4194304,
  "retention": {
    "enabled": true,
    "archive_completed_worktrees": true,
    "failed_logs_days": 7,
    "cache_max_bytes": 67108864,
    "cache_max_entries": 20000,
    "history_days": 90,
    "sweep_interval_seconds": 3600,
    "max_delivery_bytes": 268435456
  }
}
