{
  "name": "multi-agent-harness",
  "displayName": "Multi Agent Harness",
  "description": "Agent-First Multi-Agent Workspace Engine for Multi Agent IDE",
  "version": "1.0.0",
  "publisher": "multiagentide",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "multi-agent-swarm",
          "title": "Agent Swarm",
          "icon": "resources/agent-swarm.svg"
        }
      ]
    },
    "views": {
      "multi-agent-swarm": [
        {
          "type": "webview",
          "id": "multi-agent.swarmControlView",
          "name": "Swarm Chat & Control"
        }
      ]
    },
    "commands": [
      {
        "command": "multiAgent.newSession",
        "title": "Multi Agent: Start New Swarm Session",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.approvePlan",
        "title": "Multi Agent: Approve Current Plan",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.refreshWorktrees",
        "title": "Multi Agent: Refresh Worktrees",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.openArchitectureMap",
        "title": "Multi Agent: Open Visual Architecture Map",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.setupCockpitLayout",
        "title": "Multi Agent: Reset Cockpit 3-Column Layout",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.startDaemon",
        "title": "Multi Agent: Start Python Hub Daemon",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.stopDaemon",
        "title": "Multi Agent: Stop Python Hub Daemon",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.showDoctor",
        "title": "Multi Agent: Run Environment Doctor",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.clearAuditorDiagnostics",
        "title": "Multi Agent: Clear Auditor Diagnostics",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.simulateAuditorReport",
        "title": "Multi Agent: Simulate Auditor Check",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.assignRoles",
        "title": "Multi Agent: Assign Swarm Roles",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.loginCliAccount",
        "title": "Multi Agent: Sign in with CLI Account",
        "category": "Multi Agent"
      },
      {
        "command": "multiAgent.configureProviders",
        "title": "Multi Agent: Configure Agent Settings & Providers",
        "category": "Multi Agent"
      }
    ],
    "configuration": {
      "title": "Multi Agent Swarm",
      "properties": {
        "workbench.agentCockpit.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable native 3-column Agent Cockpit layout on launch (PLAN.md, Multi-Diff Staging, Swarm Activity)."
        },
        "multiAgent.roleMapping.architect": {
          "type": "string",
          "enum": ["antigravity", "codex", "claude", "copilot"],
          "enumItemLabels": [
            "Google Antigravity (Gemini)",
            "OpenAI Codex",
            "Anthropic Claude Code",
            "GitHub Copilot"
          ],
          "default": "antigravity",
          "description": "Lead Architect agent: decomposes engineering goals into living PLAN.md."
        },
        "multiAgent.roleMapping.worker": {
          "type": "string",
          "enum": ["antigravity", "codex", "claude", "copilot"],
          "enumItemLabels": [
            "Google Antigravity (Gemini)",
            "OpenAI Codex",
            "Anthropic Claude Code",
            "GitHub Copilot"
          ],
          "default": "antigravity",
          "description": "Algorithm Worker agent: implements source files and creates multi-diff staging."
        },
        "multiAgent.roleMapping.auditor": {
          "type": "string",
          "enum": ["antigravity", "codex", "claude", "copilot"],
          "enumItemLabels": [
            "Google Antigravity (Gemini)",
            "OpenAI Codex",
            "Anthropic Claude Code",
            "GitHub Copilot"
          ],
          "default": "antigravity",
          "description": "Security & QA Auditor agent: runs AST checks, security invariants, and unit verification."
        },
        "multiAgent.apiKey.gemini": {
          "type": "string",
          "default": "",
          "description": "Fallback Gemini API Key. Used ONLY if CLI account login is unavailable."
        },
        "multiAgent.apiKey.openai": {
          "type": "string",
          "default": "",
          "description": "Fallback OpenAI API Key. Used ONLY if Codex CLI account login or subscription is unavailable."
        },
        "multiAgent.apiKey.anthropic": {
          "type": "string",
          "default": "",
          "description": "Fallback Anthropic API Key. Used ONLY if Claude CLI account login is unavailable."
        },
        "multiAgent.customProviders": {
          "type": "array",
          "default": [],
          "description": "Custom Agent CLIs registered for Swarm workflows.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "command": { "type": "string" },
              "roles": { "type": "array", "items": { "type": "string" } },
              "defaultModel": { "type": "string" }
            },
            "required": ["id", "name", "command"]
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}

